// The Strategist — CMS & Platform data model
// SQLite for development. JSON-shaped fields are stored as String (parsed in app layer)
// because SQLite has no native scalar-list / enum support.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// AUTH & ACCESS CONTROL
// ============================================================

model Role {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)
  permissions String   @default("[]") // JSON array of permission keys, or ["*"] for all
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  passwordHash     String
  name             String
  avatarUrl        String?
  designation      String?
  roleId           String
  role             Role      @relation(fields: [roleId], references: [id])
  isActive         Boolean   @default(true)
  twoFactorEnabled Boolean   @default(false)
  lastLoginAt      DateTime?
  sessions         Session[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================
// SITE-WIDE SETTINGS (singleton row id = "singleton")
// ============================================================

model SiteSetting {
  id                 String  @id @default("singleton")
  siteName           String  @default("The Strategist")
  tagline            String  @default("Gain the competitive edge")
  logoUrl            String?
  logoDarkUrl        String?
  faviconUrl         String?
  loadingLogoUrl     String?
  companyDescription String  @default("")

  // Contact
  businessEmail String  @default("")
  supportEmail  String  @default("")
  salesEmail    String  @default("")
  phone         String  @default("")
  whatsapp      String  @default("")
  address       String  @default("")
  mapsUrl       String  @default("")
  businessHours String  @default("[]") // JSON

  // Social
  linkedin  String @default("")
  facebook  String @default("")
  instagram String @default("")
  youtube   String @default("")
  twitter   String @default("")
  threads   String @default("")

  // Branding
  primaryColor   String @default("#1c64d8")
  secondaryColor String @default("#6027e8")
  accentColor    String @default("#06b0d2")

  // Default SEO
  defaultSeoTitle       String @default("The Strategist")
  defaultSeoDescription String @default("")
  defaultKeywords       String @default("") // comma separated
  ogTitle               String @default("The Strategist")
  ogDescription         String @default("")
  ogImage               String @default("")

  // Integrations / forms
  formEndpoint String  @default("")
  gaId         String  @default("")
  metaPixelId  String  @default("")

  // Modes
  maintenanceMode Boolean @default(false)
  announcement    String  @default("") // JSON {enabled,text,url,label}
  theme           String  @default("aurora") // "aurora" (light pastel) | "nebula" (dark infographic)

  updatedAt DateTime @updatedAt
}

// ============================================================
// NAVIGATION
// ============================================================

model NavigationItem {
  id           String           @id @default(cuid())
  label        String
  url          String
  icon         String?
  description  String?
  location     String           @default("header") // header | footer
  footerColumn String?          // for footer grouping
  megaGroup    String?          // header mega-menu group key
  order        Int              @default(0)
  openInNewTab Boolean          @default(false)
  visible      Boolean          @default(true)
  parentId     String?
  parent       NavigationItem?  @relation("NavChildren", fields: [parentId], references: [id])
  children     NavigationItem[] @relation("NavChildren")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([location, order])
}

// ============================================================
// PAGES & SECTIONS
// ============================================================

model Page {
  id             String        @id @default(cuid())
  slug           String        @unique
  title          String
  status         String        @default("published") // draft | published
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  ogImage        String?
  canonical      String?
  robots         String        @default("index,follow")
  sections       PageSection[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model PageSection {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  key       String   // stable identifier e.g. "hero", "solutions"
  type      String   // component type
  title     String?  // admin-facing label
  order     Int      @default(0)
  visible   Boolean  @default(true)
  data      String   @default("{}") // JSON payload
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pageId, order])
}

// ============================================================
// MEDIA LIBRARY
// ============================================================

model MediaFolder {
  id       String        @id @default(cuid())
  name     String
  parentId String?
  parent   MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children MediaFolder[] @relation("FolderTree")
  assets   MediaAsset[]
  createdAt DateTime     @default(now())
}

model MediaAsset {
  id        String       @id @default(cuid())
  folderId  String?
  folder    MediaFolder? @relation(fields: [folderId], references: [id])
  url       String
  type      String       @default("image") // image | video | document | audio | svg
  filename  String
  alt       String       @default("")
  caption   String       @default("")
  tags      String       @default("") // comma separated
  width     Int?
  height    Int?
  size      Int?
  createdAt DateTime     @default(now())

  @@index([type])
}

// ============================================================
// BLOG
// ============================================================

model Author {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  designation String?
  bio         String?
  photoUrl    String?
  social      String     @default("{}") // JSON
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  order       Int        @default(0)
  posts       BlogPost[]
}

model BlogTag {
  id    String        @id @default(cuid())
  name  String
  slug  String        @unique
  posts BlogPostTag[]
}

model BlogPost {
  id             String        @id @default(cuid())
  title          String
  slug           String        @unique
  excerpt        String        @default("")
  content        String        @default("")
  coverImage     String?
  categoryId     String?
  category       BlogCategory? @relation(fields: [categoryId], references: [id])
  authorId       String?
  author         Author?       @relation(fields: [authorId], references: [id])
  status         String        @default("draft") // draft | published | scheduled
  featured       Boolean       @default(false)
  editorsPick    Boolean       @default(false)
  publishedAt    DateTime?
  readingMinutes Int           @default(4)
  views          Int           @default(0)
  seoTitle       String?
  seoDescription String?
  tags           BlogPostTag[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status, publishedAt])
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
}

// ============================================================
// MARKETING COLLECTIONS
// ============================================================

model Testimonial {
  id          String  @id @default(cuid())
  name        String
  company     String?
  designation String?
  photoUrl    String?
  quote       String
  rating      Int     @default(5)
  order       Int     @default(0)
  visible     Boolean @default(true)
}

model ClientLogo {
  id      String  @id @default(cuid())
  name    String
  logoUrl String
  website String?
  order   Int     @default(0)
  visible Boolean @default(true)
}

model Faq {
  id       String  @id @default(cuid())
  question String
  answer   String
  group    String  @default("general") // page/context key
  order    Int     @default(0)
  visible  Boolean @default(true)

  @@index([group, order])
}

model TeamMember {
  id       String  @id @default(cuid())
  name     String
  position String?
  photoUrl String?
  bio      String?
  social   String  @default("{}")
  order    Int     @default(0)
  visible  Boolean @default(true)
}

model ProductCategory {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  order    Int       @default(0)
  products Product[]
}

model Product {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  categoryId       String?
  category         ProductCategory? @relation(fields: [categoryId], references: [id])
  shortDescription String           @default("")
  description      String           @default("")
  icon             String?
  coverImage       String?
  features         String           @default("[]") // JSON
  gallery          String           @default("[]") // JSON
  ctaLabel         String?
  featured         Boolean          @default(false)
  order            Int              @default(0)
  status           String           @default("published")
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model CourseCategory {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  topics      String   @default("[]") // JSON list of topic strings
  order       Int      @default(0)
  courses     Course[]
}

// Content-only course listings (no LMS: no enrollment/assessments/certificates issued)
model Course {
  id               String          @id @default(cuid())
  title            String
  slug             String          @unique
  categoryId       String?
  category         CourseCategory? @relation(fields: [categoryId], references: [id])
  thumbnail        String?
  level            String?
  duration         String?
  language         String?         @default("English")
  instructor       String?
  modulesCount     Int             @default(0)
  shortDescription String          @default("")
  description      String          @default("")
  objectives       String          @default("[]") // JSON
  audience         String          @default("[]") // JSON
  prerequisites    String          @default("[]") // JSON
  curriculum       String          @default("[]") // JSON [{title, lessons:[]}]
  certificate      Boolean         @default(true)
  featured         Boolean         @default(false)
  order            Int             @default(0)
  status           String          @default("published")
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Department {
  id          String       @id @default(cuid())
  name        String
  description String?
  order       Int          @default(0)
  jobs        JobOpening[]
}

model JobOpening {
  id             String      @id @default(cuid())
  title          String
  slug           String      @unique
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  employmentType String      @default("Full-time")
  experience     String?
  location       String?
  description    String      @default("")
  responsibilities String    @default("[]") // JSON
  qualifications String      @default("[]") // JSON
  skills         String      @default("[]") // JSON
  salary         String?
  status         String      @default("open") // open | closed
  postedAt       DateTime    @default(now())
  applyUrl       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model OfficeLocation {
  id           String  @id @default(cuid())
  name         String
  address      String
  mapsUrl      String?
  phone        String?
  email        String?
  workingHours String? // JSON
  order        Int     @default(0)
}

// ============================================================
// FORMS & LEADS
// ============================================================

model FormSubmission {
  id        String   @id @default(cuid())
  formType  String   // contact | consultation | career | product-demo | generic
  name      String?
  email     String?
  phone     String?
  subject   String?
  data      String   @default("{}") // JSON of all fields
  status    String   @default("new") // new | read | replied | archived
  ip        String?
  createdAt DateTime @default(now())

  @@index([formType, status])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  name      String?
  email     String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

// ============================================================
// AUDIT LOG
// ============================================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  userEmail String?
  action    String   // create | update | delete | login | logout | publish
  module    String
  entityId  String?
  summary   String?
  oldValue  String?
  newValue  String?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([module, createdAt])
}

// ============================================================
// SERVICES & SERVICE CATEGORIES
// ============================================================

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  order       Int       @default(0)
  services    Service[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Service {
  id               String           @id @default(cuid())
  name             String
  slug             String           @unique
  categoryId       String?
  category         ServiceCategory? @relation(fields: [categoryId], references: [id])
  shortDescription String           @default("")
  description      String           @default("")
  icon             String?
  features         String           @default("[]") // JSON list of feature strings
  featured         Boolean          @default(false)
  order            Int              @default(0)
  status           String           @default("published")
  seoTitle         String?
  seoDescription   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

// ============================================================
// CMS-DRIVEN STRATEGIST DATA
// ============================================================

model StrategistIndustry {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  order       Int      @default(0)
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("strategist_industries")
}

model StrategistApproachStage {
  id          String   @id @default(cuid())
  step        Int      @unique
  title       String
  description String?
  visible     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("strategist_approach_stages")
}

